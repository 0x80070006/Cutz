<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Hard guarantee of the offline promise: even if a future dependency declared
         INTERNET in its own manifest, the merger strips it. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Package visibility (Android 11+): we only need launchable apps, so a <queries>
         intent filter is enough; QUERY_ALL_PACKAGES is deliberately not requested. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Lets us check that a browser exists before pinning a web link. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- allowBackup=false: the database only makes sense together with the pinned
         shortcuts of this device, which are not restored by Android backup. Users
         move their list with the JSON export instead. -->
    <application
        android:name=".CutzApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Cutz"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Trampoline started by every pinned shortcut. It only receives a shortcut id
             and looks the target up in the local database, so another app sending
             an intent here cannot make Cutz open an arbitrary URL or package
             (no intent redirection). It is translucent and finishes immediately. -->
        <activity
            android:name=".shortcut.LaunchActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Cutz.Trampoline">
            <intent-filter>
                <action android:name="fr.cutz.action.LAUNCH_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- ACTION_PACKAGE_FULLY_REMOVED is one of the few implicit broadcasts still
             delivered to manifest receivers on Android 8+. It is a protected broadcast
             (only the system can send it), so exporting the receiver is safe. -->
        <receiver
            android:name=".shortcut.PackageRemovedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Called back by the launcher once the user accepted the pin dialog. -->
        <receiver
            android:name=".shortcut.PinResultReceiver"
            android:exported="false" />
    </application>
</manifest>
